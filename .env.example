# Public application configuration
NEXT_PUBLIC_APP_URL=https://invoicereconcile.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@invoicereconcile.com
# Analytics flags must be explicit in production. GA is enabled only when an ID is supplied.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=true
NEXT_PUBLIC_FIRST_PARTY_ANALYTICS_ENABLED=true

# Legal operator details. Counsel should approve these values before launch.
NEXT_PUBLIC_LEGAL_NAME=InvoiceReconcile
NEXT_PUBLIC_LEGAL_BUSINESS_ADDRESS=
NEXT_PUBLIC_LEGAL_GOVERNING_LAW=
NEXT_PUBLIC_LEGAL_COURT_VENUE=

# Supabase. Provision through the Vercel Marketplace or your existing Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public demo. Production validation requires a strong secret only when this is enabled.
ENABLE_DEMO_MODE=false
DEMO_SESSION_SECRET=
ADMIN_EMAILS=

# Stripe. Production releases require live keys, the signed webhook secret, and three distinct monthly Price IDs.
# Live keys are disabled unless this is explicitly live. Keep previews on test with a separate database.
STRIPE_BILLING_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BOOKKEEPER=

# Postmark transactional email
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=invoicereconcile
POSTMARK_FROM_EMAIL=notifications@invoicereconcile.com
# General enquiries. Support issues continue to use NEXT_PUBLIC_SUPPORT_EMAIL.
CONTACT_NOTIFICATION_EMAIL=contact@invoicereconcile.com

# Upstash-backed rate limiting. Required for production release validation.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Future provider adapters. A configured client does not imply a live connection.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
STRIPE_CONNECT_CLIENT_ID=
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=

# Structured logging
LOG_LEVEL=info

# Optional analytics and search verification
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
